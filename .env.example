# Development only. Production build rejects localhost/missing API configuration.
VITE_API_BASE_URL=http://localhost:3000/api
# Production: set an HTTPS API base, or /api with an intentional same-origin proxy.
VITE_FEATURE_BOOKING=true
# Google CustomerAccount login only. Public web client ID, never a client secret.
# Enable both frontend/backend flags with matching IDs and authorized JS origins.
VITE_FEATURE_GOOGLE_LOGIN=false
VITE_GOOGLE_CLIENT_ID=
